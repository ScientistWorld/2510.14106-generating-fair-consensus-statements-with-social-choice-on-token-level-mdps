{
  "experiments": {
    "consensus_generation_habermas_scenarios": {
      "description": "Main consensus-generation benchmark on three Habermas Machine scenarios using Egalitarian Perplexity (Table 10 / Figure 4). Lower EPPL indicates better worst-agent alignment.",
      "weight": 0.75,
      "primary_metric": "overall_eppl",
      "metrics": {
        "scenario1_eppl": {
          "higher_is_better": false,
          "coefficient": -0.3
        },
        "scenario2_eppl": {
          "higher_is_better": false,
          "coefficient": -0.3
        },
        "scenario3_eppl": {
          "higher_is_better": false,
          "coefficient": -0.3
        },
        "overall_eppl": {
          "higher_is_better": false,
          "coefficient": -1.0
        }
      },
      "results": {
        "beam_search": {
          "type": "proposed",
          "scenario1_eppl": 3.22,
          "scenario2_eppl": 2.66,
          "scenario3_eppl": 2.74,
          "overall_eppl": 2.87
        },
        "finite_lookahead": {
          "type": "proposed",
          "scenario1_eppl": 4.29,
          "scenario2_eppl": 3.83,
          "scenario3_eppl": 4.43,
          "overall_eppl": 4.18
        },
        "best_of_n": {
          "type": "baseline",
          "scenario1_eppl": 8.57,
          "scenario2_eppl": 6.70,
          "scenario3_eppl": 3.77,
          "overall_eppl": 6.35
        },
        "prompted_habermas_machine": {
          "type": "baseline",
          "scenario1_eppl": 10.58,
          "scenario2_eppl": 10.39,
          "scenario3_eppl": 8.03,
          "overall_eppl": 9.67
        },
        "habermas_machine_chinchilla": {
          "type": "baseline",
          "scenario1_eppl": 17.18,
          "scenario2_eppl": 15.71,
          "scenario3_eppl": 14.18,
          "overall_eppl": 15.69
        }
      }
    },
    "empirical_core_test": {
      "description": "Empirical ex-ante-core validation on the small synthetic token tree in Figure 2. A maximum coalition improvement of 1 means no coalition can block the policy.",
      "weight": 0.25,
      "primary_metric": "max_coalition_improvement",
      "metrics": {
        "max_coalition_improvement": {
          "higher_is_better": false,
          "coefficient": -1.0
        },
        "core_constraint_satisfied": {
          "higher_is_better": true,
          "coefficient": 0.5
        },
        "rho_0_max_coalition_improvement": {
          "higher_is_better": false,
          "coefficient": -0.1
        },
        "rho_1_max_coalition_improvement": {
          "higher_is_better": false,
          "coefficient": -0.1
        },
        "rho_2_max_coalition_improvement": {
          "higher_is_better": false,
          "coefficient": -0.1
        },
        "rho_4_max_coalition_improvement": {
          "higher_is_better": false,
          "coefficient": -0.1
        },
        "rho_8_max_coalition_improvement": {
          "higher_is_better": false,
          "coefficient": -0.1
        }
      },
      "results": {
        "nash_welfare_policy": {
          "type": "proposed",
          "max_coalition_improvement": 1.0,
          "core_constraint_satisfied": 1.0,
          "rho_0_max_coalition_improvement": 1.0,
